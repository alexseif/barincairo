# Local Nginx Virtual Host Configuration for barincairo.local
# Place in /etc/nginx/sites-available/barincairo-local.conf and symlink to /etc/nginx/sites-enabled/

# --- HTTP to HTTPS Redirect ---
server {
    listen 80;
    listen [::]:80;
    server_name barincairo.local www.barincairo.local api.barincairo.local;
    return 301 https://$host$request_uri;
}

# --- Vite SPA Frontend + Proxy /api/ Server Block ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name barincairo.local www.barincairo.local;

    # OpenSSL Self-Signed Certificates
    ssl_certificate /etc/ssl/barincairo-local/fullchain.pem;
    ssl_certificate_key /etc/ssl/barincairo-local/privkey.pem;

    access_log /var/log/nginx/barincairo_local_access.log;
    error_log /var/log/nginx/barincairo_local_error.log;

    # Gzip Compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    # Proxy API Requests Directly to FastAPI Backend
    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Frontend SPA Proxy
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- FastAPI Backend & Admin Server Block ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.barincairo.local;

    # OpenSSL Self-Signed Certificates
    ssl_certificate /etc/ssl/barincairo-local/fullchain.pem;
    ssl_certificate_key /etc/ssl/barincairo-local/privkey.pem;

    access_log /var/log/nginx/barincairo_local_api_access.log;
    error_log /var/log/nginx/barincairo_local_api_error.log;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
