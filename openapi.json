      },
      "CategoryResponse": {
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "pattern": "^[a-z0-9-]+$",
            "title": "Slug",
            "description": "Unique URL-friendly slug",
            "examples": [
              "bars"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "description": "Category display name",
            "examples": [
              "Bars & Pubs"
            ]
          },
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Primary key ID"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "name",
          "id"
        ],
        "title": "CategoryResponse"
      },
      "ErrorModel": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorModel"
      },
