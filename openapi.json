            "default": "FeatureCollection"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/GeoJSONFeature"
            },
            "type": "array",
            "title": "Features",
            "description": "List of GeoJSON features"
          }
        },
        "type": "object",
        "title": "GeoJSONFeatureCollection"
      },
      "GeoJSONGeometry": {
        "properties": {
          "type": {
            "type": "string",
