# Environment Variable Template for barincairo.com
# Copy this file to .env and replace placeholder values with secure credentials.
# NEVER commit the actual .env file to Git!

POSTGRES_DB=barincairo_db
POSTGRES_USER=barincairo_user
POSTGRES_PASSWORD=generate_a_strong_password_here
SECRET_KEY=generate_a_secure_jwt_secret_key_here
NEXT_PUBLIC_API_URL=https://api.barincairo.com
